# --- Local working data / test output (never committed) ---
# The plugin writes candidate data and generated documents to its *working
# directory*. Running the skills from inside this repo during development drops
# them here; real use happens in a separate private folder. Unanchored so they
# match at the repo root and inside plugins/job-application/.
resume_sections/
applications/
all cv/
jobapp.config.yml
interview_playbook.md

# --- Working notes ---
/docs/
/.superpowers/

# --- Build artefacts ---
*.aux
*.log
*.out
*.synctex.gz
*.rendered.html
templates/preview/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# --- Keep tracked ---
!/plugins/job-application/example/
!/plugins/job-application/templates/workspace/**
